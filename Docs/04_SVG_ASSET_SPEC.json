{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/svg_asset_spec.json",
  "title": "Wordwell SVG Illustration Binding Schema",
  "description": "Binding metadata for SVG illustrations. Visual rules come from design.md: monochrome line art for word meanings and decoration.",
  "type": "object",
  "required": [
    "schemaVersion",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 2
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/illustrationBinding"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "illustrationBinding": {
      "type": "object",
      "required": [
        "id",
        "word",
        "lemma",
        "assetName",
        "assetPath",
        "style",
        "contexts",
        "version",
        "tags",
        "isDecorative"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable unique identifier for this binding. Recommended: illustration.<lemma>.<pos?>"
        },
        "word": {
          "type": "string",
          "minLength": 1
        },
        "lemma": {
          "type": "string",
          "minLength": 1
        },
        "partOfSpeech": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "noun",
            "verb",
            "adjective",
            "adverb",
            "pronoun",
            "preposition",
            "conjunction",
            "interjection",
            "determiner",
            "phrase",
            null
          ]
        },
        "senseId": {
          "type": [
            "string",
            "null"
          ],
          "description": "Optional dictionary sense identifier when one lemma needs different illustrations by meaning."
        },
        "assetName": {
          "type": "string",
          "pattern": "^word_[a-z0-9_]+$",
          "description": "Logical asset name without file extension."
        },
        "assetPath": {
          "type": "string",
          "pattern": "^Resources/IllustrationsSVG/Words\\.xcassets/word_[a-z0-9_]+\\.imageset/word_[a-z0-9_]+\\.svg$",
          "description": "Source path relative to the WordwellDesign target; the image set preserves the vector representation."
        },
        "style": {
          "type": "string",
          "enum": [
            "monochrome_line_art",
            "color_swatch"
          ]
        },
        "contexts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "header",
              "dictionary_entry",
              "library",
              "review",
              "speaking"
            ]
          }
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "altText": {
          "type": [
            "string",
            "null"
          ],
          "description": "Accessibility description if the illustration is informative rather than decorative."
        },
        "isDecorative": {
          "type": "boolean",
          "default": false
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "isDecorative": {
                "const": false
              }
            }
          },
          "then": {
            "required": [
              "altText"
            ],
            "properties": {
              "altText": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "style": {
                "const": "color_swatch"
              }
            }
          },
          "then": {
            "properties": {
              "contexts": {
                "const": [
                  "dictionary_entry"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "style": {
                "const": "monochrome_line_art"
              }
            }
          },
          "then": {
            "properties": {
              "contexts": {
                "items": {
                  "enum": [
                    "header",
                    "dictionary_entry",
                    "library",
                    "review",
                    "speaking"
                  ]
                }
              }
            }
          }
        }
      ]
    }
  },
  "examples": [
    {
      "schemaVersion": 2,
      "assets": [
        {
          "id": "illustration.family.noun",
          "word": "family",
          "lemma": "family",
          "partOfSpeech": "noun",
          "senseId": null,
          "assetName": "word_family_line",
          "assetPath": "Resources/IllustrationsSVG/Words.xcassets/word_family_line.imageset/word_family_line.svg",
          "style": "monochrome_line_art",
          "contexts": [
            "library",
            "review"
          ],
          "version": 1,
          "tags": [
            "people",
            "home",
            "relatives"
          ],
          "altText": "A small family standing together in a vintage line-art illustration.",
          "isDecorative": false,
          "notes": "Reuse in Library and Review."
        },
        {
          "id": "illustration.family.noun.plate",
          "word": "family",
          "lemma": "family",
          "partOfSpeech": "noun",
          "senseId": null,
          "assetName": "word_family_plate",
          "assetPath": "Resources/IllustrationsSVG/Words.xcassets/word_family_plate.imageset/word_family_plate.svg",
          "style": "monochrome_line_art",
          "contexts": [
            "dictionary_entry"
          ],
          "version": 1,
          "tags": [
            "people",
            "home",
            "relatives"
          ],
          "altText": "A family drawn in simple dark outlines.",
          "isDecorative": false,
          "notes": "Use only on the Dictionary Entry screen."
        },
        {
          "id": "illustration.branch.noun",
          "word": "branch",
          "lemma": "branch",
          "partOfSpeech": "noun",
          "senseId": null,
          "assetName": "word_branch_line",
          "assetPath": "Resources/IllustrationsSVG/Words.xcassets/word_branch_line.imageset/word_branch_line.svg",
          "style": "monochrome_line_art",
          "contexts": [
            "library",
            "review"
          ],
          "version": 1,
          "tags": [
            "tree",
            "plant",
            "nature"
          ],
          "altText": "A botanical tree branch drawn as a monochrome engraving.",
          "isDecorative": false,
          "notes": null
        },
        {
          "id": "illustration.journey.noun",
          "word": "journey",
          "lemma": "journey",
          "partOfSpeech": "noun",
          "senseId": null,
          "assetName": "word_journey_line",
          "assetPath": "Resources/IllustrationsSVG/Words.xcassets/word_journey_line.imageset/word_journey_line.svg",
          "style": "monochrome_line_art",
          "contexts": [
            "library",
            "review"
          ],
          "version": 1,
          "tags": [
            "travel",
            "mountain",
            "path"
          ],
          "altText": "A winding mountain path represented in vintage monochrome line art.",
          "isDecorative": false,
          "notes": null
        }
      ]
    }
  ]
}
